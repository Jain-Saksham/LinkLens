# Copy to frontend/.env.local (git-ignored).

# Dev only: where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:8080

# Production builds only: absolute API origin if the UI is served from a different origin than the API.
# Leave empty to call /api on the same origin.
VITE_API_BASE_URL=

# Shown as the alias prefix in the form ("localhost:8080/my-link"). Should match the backend's APP_BASE_URL.
VITE_SHORT_BASE_URL=http://localhost:8080
