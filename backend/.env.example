# Copy to backend/.env (git-ignored). Real environment variables take precedence over this file.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/linklens
# Homebrew PostgreSQL has no "postgres" role: use your macOS username (`whoami`) and an empty password.
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
# Fail fast (ms) when the database is unreachable.
DB_CONNECTION_TIMEOUT_MS=3000

# --- Redis (optional cache: the app works without it) ---
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT=250ms
CACHE_ENABLED=true
CACHE_TTL=1h
CACHE_NEGATIVE_TTL=60s
CACHE_FAILURE_BACKOFF=30s

# --- Rate limiting for link creation (token bucket per client IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PERIOD=1m
# Behind a trusted reverse proxy set to "native" or "framework" so the real client IP is used.
FORWARD_HEADERS_STRATEGY=none

# --- Link-rot monitoring (background checks of each destination) ---
HEALTH_CHECKS_ENABLED=true
HEALTH_POLL_INTERVAL=30s
# How often a healthy link is re-checked; failing links back off from 15m up to this.
HEALTH_CHECK_INTERVAL=24h
# Consecutive failed checks before a link is flagged BROKEN (one failure = WARNING).
HEALTH_FAILURE_THRESHOLD=2

# --- Live click counter (Server-Sent Events) ---
LIVE_MAX_PER_LINK=50
LIVE_MAX_TOTAL=1000

# --- Server ---
SERVER_PORT=8080
# Public origin used to build short links returned by the API.
APP_BASE_URL=http://localhost:8080
SHORT_CODE_LENGTH=7
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Actuator endpoints to expose (add "metrics" for load testing; restrict access in production).
MANAGEMENT_ENDPOINTS=health
